# 账户凭据
# 复制本文件为 .env 后填写。.env 已在 .gitignore 中，切勿提交或分享。
#
# 每个账户一个编号块，编号可以跳过不连续（例如没有 ACCOUNT_1 也能直接用 ACCOUNT_2）。
#
# LANG_CODE 接受 BCP 47 语言标签，例如 zh-CN、en、pt-BR。
# GEO_LOCALE 接受两位国家代码。auto 表示在首次成功请求面板后缓存微软档案国家，
# 用于后续浏览器指纹与请求头。国内账号建议固定为 CN / zh-CN，配合 china 热搜源。

# ── 账户 1 ─────────────────────────────────────────────
ACCOUNT_1_EMAIL=email@example.com
# 无密码 / 仅验证器登录的账户可以留空
#ACCOUNT_1_PASSWORD=your_password
#ACCOUNT_1_TOTP_SECRET=
#ACCOUNT_1_RECOVERY_EMAIL=
ACCOUNT_1_GEO_LOCALE=CN
ACCOUNT_1_LANG_CODE=zh-CN
# 浏览器代理：HTTP/HTTPS/SOCKS4/SOCKS5。SOCKS 代理不支持认证。
#ACCOUNT_1_PROXY_HTTP=false
#ACCOUNT_1_PROXY_URL=
#ACCOUNT_1_PROXY_PORT=0
#ACCOUNT_1_PROXY_USERNAME=
#ACCOUNT_1_PROXY_PASSWORD=
# 复用已保存的指纹（同一账户长期用同一指纹，减少风控特征变化）
#ACCOUNT_1_SAVE_FINGERPRINT_MOBILE=false
#ACCOUNT_1_SAVE_FINGERPRINT_DESKTOP=false

# ── 账户 2（继续增加账户就复制这一段，编号任意正整数）─────
#ACCOUNT_2_EMAIL=email_2@example.com
#ACCOUNT_2_PASSWORD=your_password
#ACCOUNT_2_TOTP_SECRET=
#ACCOUNT_2_RECOVERY_EMAIL=
#ACCOUNT_2_GEO_LOCALE=CN
#ACCOUNT_2_LANG_CODE=zh-CN
#ACCOUNT_2_PROXY_HTTP=false
#ACCOUNT_2_PROXY_URL=
#ACCOUNT_2_PROXY_PORT=0
#ACCOUNT_2_PROXY_USERNAME=
#ACCOUNT_2_PROXY_PASSWORD=

# ── 任务与搜索的少量覆盖项（其余在 config.json）─────────
#CONFIG_TASK_DELAY_MIN=15sec
#CONFIG_TASK_DELAY_MAX=30sec
#CONFIG_SEARCH_ON_BING_MAX_ATTEMPTS=3

# ── 中国热搜源（gmya.net）──────────────────────────────
# 免费档有频率限制（会返回 403「请求过于频繁」）。
# 到 https://gmya.net 申请 appkey 填入即可解除限流；属于个人配额密钥，不要提交。
#CONFIG_CHINA_API_APPKEY=

# ── 微信推送（二选一或同时开）──────────────────────────
# PushPlus：https://www.pushplus.plus 微信扫码登录后复制 token
#CONFIG_PUSHPLUS_ENABLED=false
#CONFIG_PUSHPLUS_TOKEN=
#CONFIG_PUSHPLUS_TITLE=微软奖励脚本
#CONFIG_PUSHPLUS_TEMPLATE=markdown
# Server酱 Turbo：https://sct.ftqq.com 微信扫码后复制 SCT 开头的 SendKey
#CONFIG_SERVERCHAN_ENABLED=false
#CONFIG_SERVERCHAN_SENDKEY=
#CONFIG_SERVERCHAN_TITLE=微软奖励脚本

# ── 控制 API（npm run api，或 compose.yaml 里 API_MODE=true）──
# 文档见 docs/control-api.md；生成 token：
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#API_TOKEN=

# 忽略微软明确给出的 bot 警告继续运行（默认 false，不建议打开）
#CONFIG_CONTINUE_ON_BOT_WARNING=false

# 查询语言：true 表示按账户国家推导；false 表示固定英文/美国
#CONFIG_SEARCH_USE_ACCOUNT_LOCALE=true
